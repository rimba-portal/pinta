{
    "name": "rimba/pinta",
    "description": "A workflow engine, the enterprise execution layer for Rimba.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "BIT Ecosystem",
            "email": "bit.ecosystem@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "rimba/asas": "^1.3"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rimba\\Workflow\\WorkflowServiceProvider"
            ]
        }
    },
    "autoload": {
        "psr-4": {
           "Rimba\\Workflow\\": "src/"
        }
    },
    "minimum-stability": "alpha",
    "prefer-stable": true
}
